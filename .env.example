# Copy to .env or export these before running. All are optional for a local demo.
DEBUG=1
GEOCODER_URL=https://photon.komoot.io
# Optional when running Vite and Django separately.
# DJANGO_ORIGIN=http://127.0.0.1:8000
# DJANGO_PORT=8000
# VITE_PORT=5173
DEMO_MODE=1                      # adds the user switcher and the "Scan next (demo)" helper
SECRET_KEY=change-me-in-production
SITE_URL=http://localhost:5173   # public frontend origin used in customer links
DEMO_PASSWORD=sunthread-demo     # shared password of every seeded demo account (local demo only)
ALLOWED_HOSTS=*                  # comma-separated hostnames in production, e.g. app.example.com
ENQUIRY_API_KEY=demo-key        # X-API-Key for POST /api/enquiry/. Required when DEBUG=0; empty disables the webhook
